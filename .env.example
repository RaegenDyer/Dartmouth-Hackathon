# Application runtime settings. Copy this file to .env.local.
# The preparation page, health endpoint, and build work with these values blank.
# If either public Supabase setting is filled in, both must be valid.

# Browser-safe Supabase project settings; database policies enforce access.
NEXT_PUBLIC_SUPABASE_URL=
# Use an sb_publishable_ key (or legacy anon JWT), never a secret/service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Claude configuration. Select the model during implementation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional Deepgram voice-input preparation. Leave disabled for text-only work.
# This flag/configuration alone does not implement microphone or audio transport.
VOICE_INPUT_ENABLED=false
# Server only: never put the permanent key in a NEXT_PUBLIC_* variable.
DEEPGRAM_API_KEY=

# Management tokens belong in the ignored credentials.env, never in app code.
# VERCEL_TOKEN, SUPABASE_ACCESS_TOKEN, and GITHUB_TOKEN are not app settings.

# Companion core.
# LLM_ADAPTER selects "mock" (deterministic, no key needed; used in CI) or "anthropic".
LLM_ADAPTER=mock
# 32 random bytes, base64. Encrypts emergency contacts at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONTACT_ENCRYPTION_KEY=
