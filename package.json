{
  "name": "dartmouth-hackathon",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:contracts": "node --experimental-default-type=module --experimental-strip-types --test scripts/check-contracts.mjs",
    "check:runtime": "node --experimental-default-type=module --experimental-strip-types --conditions=react-server --test scripts/check-runtime.mjs",
    "check:voice": "node --experimental-default-type=module --experimental-strip-types --test scripts/check-voice.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:contracts && npm run check:runtime && npm run check:voice && npm run check:schema"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
